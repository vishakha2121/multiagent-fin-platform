# 🤖 FinAgent AI — .gitignore
# Multi-Agent Financial Intelligence Platform
# ============================================

# ============================================
# 🐍 Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
pythonenv*

# ============================================
# 🔐 Environment Variables (CRITICAL!)
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
!.env.example

# ============================================
# 🗄️ Database Files
# ============================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/*.db
backend/database/*.db

# ============================================
# 📊 Logs
# ============================================
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/
frontend/logs/

